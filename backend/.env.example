DATABASE_URL=postgresql+psycopg://sneakertown:sneakertown@localhost:5432/sneakertown
SECRET_KEY=replace-with-a-random-string-at-least-32-characters
ENVIRONMENT=development
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173
SECURE_COOKIES=false
AUTO_CREATE_TABLES=true

# Optional Google OAuth. Add the redirect URI below in Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# Optional email delivery for password reset.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com
SMTP_STARTTLS=true
